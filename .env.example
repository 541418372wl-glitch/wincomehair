# WINCOME Hair local/server environment template.
# Copy to .env.local only for local development. Never commit real values.

# Server-only inquiry storage. SUPABASE_SERVICE_ROLE_KEY must never use a VITE_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only inquiry email notification.
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=

# Optional manual IndexNow command. Running submit:indexnow changes external state and
# requires explicit approval. Keep dry-run enabled while validating the payload.
INDEXNOW_SITE=https://wincomehair.com
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
INDEXNOW_KEY=
INDEXNOW_KEY_LOCATION=
INDEXNOW_DRY_RUN=1

# VERCEL_URL and NODE_ENV are platform/runtime-provided and are not stored here.
# The API accepts VITE_SUPABASE_URL only as a legacy server fallback; new setup must
# use SUPABASE_URL. No browser Supabase key is required by the current application.
