# WINCOME Hair local/server environment template.
# Copy to .env.local only for local development. Never commit real values.

# Server-only form routing and challenge validation. Never add a VITE_ prefix.
# Configure only in the verified production project after release approval.
FORMSPARK_FORM_ID=
TURNSTILE_SECRET_KEY=

# Public widget site key for this site's production hostnames only.
# Leave blank for local/preview builds; never use a testing key in production.
VITE_TURNSTILE_SITE_KEY=

# Optional manual IndexNow command. Running submit:indexnow changes external state and
# requires explicit approval. Keep dry-run enabled while validating the payload.
INDEXNOW_SITE=https://wincomehair.com
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
INDEXNOW_KEY=
INDEXNOW_KEY_LOCATION=
INDEXNOW_DRY_RUN=1

# VERCEL_URL, VERCEL_ENV and NODE_ENV are platform/runtime-provided.
# Supabase/Resend are not dependencies of the new inquiry intake. Keep historical
# credentials in their existing secure environment for an approved rollback only.
