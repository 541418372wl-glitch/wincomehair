{
  "routes": [
    { "handle": "filesystem" },
    { "src": "/((?!favicon\\.ico|manifest\\.json|sitemap_index\\.xml|robots\\.txt|sitemap\\.xml|llms\\.txt).*)", "dest": "/index.html" },
    { "handle": "error" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "https://www.wincomehair.com/(.*)",
      "destination": "https://wincomehair.com/$1",
      "statusCode": 308
    }
  ]
}
